rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: usuário está autenticado?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar: usuário é admin?
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Documento de teste (pode deixar)
    match /test/{testId} {
      allow read: if true;
    }

    // USUÁRIOS - AGORA PROTEGIDO
    // Leitura: qualquer autenticado pode ler perfis (o app precisa disso)
    // Escrita: só o próprio usuário OU um admin
    // Criação inicial do próprio usuário: permitida (primeiro login)
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && request.auth.uid == userId;

      allow update, delete: if isAdmin() || request.auth.uid == userId;
    }

    // VEÍCULOS
    match /veiculos/{veiculoId} {
      allow read, write: if isAuthenticated();
    }

    // VENDAS
    match /vendas/{vendaId} {
      allow read, write: if isAuthenticated();
    }

    // DESPESAS FIXAS
    match /despesasFixas/{despesaId} {
      allow read, write: if isAuthenticated();
    }

    // PROFISSÕES
    match /profissoes/{profissaoId} {
      allow read, write: if isAuthenticated();
    }

    // CONFIGURAÇÕES DA LOJA
    match /configuracoes_loja/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // MARCAS
    match /marcas/{marcaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CORES
    match /cores/{corId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CONTAS BANCÁRIAS
    match /contas_bancarias/{contaId} {
      allow read, write: if isAuthenticated();
    }

    // MOVIMENTAÇÕES DE CONTAS
    match /movimentacoes_contas/{movId} {
      allow read, write: if isAuthenticated();
    }

    // FORNECEDORES
    match /fornecedores/{fornecedorId} {
      allow read, write: if isAuthenticated();
    }

    // BANCOS PARCEIROS
    match /bancos/{bancoId} {
      allow read, write: if isAuthenticated();
    }

    // ⚠️ SEM FALLBACK AQUI. Antes tinha "match /{document=**}" que abria TUDO.
    // Foi removido de propósito.
  }
}