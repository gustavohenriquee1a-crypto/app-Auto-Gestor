rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Connection validation test document
    match /test/{testId} {
      allow read: if true;
    }

    // User profiles collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Vehicles collection
    match /veiculos/{veiculoId} {
      allow read, write: if isAuthenticated();
    }
    
    // Sales collection
    match /vendas/{vendaId} {
      allow read, write: if isAuthenticated();
    }
    
    // Fixed expenses collection
    match /despesasFixas/{despesaId} {
      allow read, write: if isAuthenticated();
    }

    // Shared professions collection
    match /profissoes/{profissaoId} {
      allow read, write: if isAuthenticated();
    }

    // Global store settings collection (logo, enterprise info)
    match /configuracoes_loja/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Brands and Colors catalogues
    match /marcas/{marcaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /cores/{corId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Bank accounts collection
    match /contas_bancarias/{contaId} {
      allow read, write: if isAuthenticated();
    }

    // Account transactions / bank statement collection
    match /movimentacoes_contas/{movId} {
      allow read, write: if isAuthenticated();
    }

    // Suppliers and partners
    match /fornecedores/{fornecedorId} {
      allow read, write: if isAuthenticated();
    }

    // Partner banks
    match /bancos/{bancoId} {
      allow read, write: if isAuthenticated();
    }

    // General fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
