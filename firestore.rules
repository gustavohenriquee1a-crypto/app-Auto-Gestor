rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: usuário está autenticado?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar: usuário é admin?
    // Inclui verificação segura de existência do documento e fallback para o email do admin master
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'gustavohenriquee1a@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Documento de teste de conexão
    match /test/{testId} {
      allow read: if true;
    }

    // USUÁRIOS - PROTEGIDO
    // Leitura: qualquer autenticado pode ler perfis para equipe e permissões
    // Criação: permitida para o próprio usuário autenticado
    // Atualização/Exclusão: permitido para o próprio usuário ou administradores
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // VEÍCULOS
    match /veiculos/{veiculoId} {
      allow read, write: if isAuthenticated();
    }

    // VENDAS
    match /vendas/{vendaId} {
      allow read, write: if isAuthenticated();
    }

    // DESPESAS FIXAS
    match /despesasFixas/{despesaId} {
      allow read, write: if isAuthenticated();
    }

    // PROFISSÕES
    match /profissoes/{profissaoId} {
      allow read, write: if isAuthenticated();
    }

    // CONFIGURAÇÕES DA LOJA
    match /configuracoes_loja/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // MARCAS
    match /marcas/{marcaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CORES
    match /cores/{corId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CONTAS BANCÁRIAS
    match /contas_bancarias/{contaId} {
      allow read, write: if isAuthenticated();
    }

    // MOVIMENTAÇÕES DE CONTAS
    match /movimentacoes_contas/{movId} {
      allow read, write: if isAuthenticated();
    }

    // FORNECEDORES
    match /fornecedores/{fornecedorId} {
      allow read, write: if isAuthenticated();
    }

    // BANCOS PARCEIROS
    match /bancos/{bancoId} {
      allow read, write: if isAuthenticated();
    }

    // CLIENTES / PAGADORES PRÉ-CADASTRADOS
    match /pagadores/{pagadorId} {
      allow read, write: if isAuthenticated();
    }
  }
}
